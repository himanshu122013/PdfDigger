@{
    ViewData["Title"] = "Home";
}

<div class="container text-center">
    <h1 class="mb-4">Welcome to PdfDigger</h1>
    <p class="lead">Choose an action below:</p>

    <div class="row">
        <!-- Remove Password -->
        <div class="col-md-3 mb-3">
            <a asp-controller="Pdf" asp-action="RemovePassword" class="text-decoration-none">
                <div class="card pdf-action-card shadow">
                    <div class="card-body text-center">
                        <i class="bi bi-lock-fill text-danger" style="font-size: 2rem;"></i>
                        <h5 class="mt-2">Remove Password</h5>
                    </div>
                </div>
            </a>
        </div>

        <!-- Merge PDF -->
        <div class="col-md-3 mb-3">
            <a asp-controller="Pdf" asp-action="Merge" class="text-decoration-none">
                <div class="card pdf-action-card shadow">
                    <div class="card-body text-center">
                        <i class="bi bi-file-earmark-plus text-primary" style="font-size: 2rem;"></i>
                        <h5 class="mt-2">Merge PDF</h5>
                    </div>
                </div>
            </a>
        </div>

        <!-- Split PDF -->
        <div class="col-md-3 mb-3">
            <a asp-controller="Pdf" asp-action="Split" class="text-decoration-none">
                <div class="card pdf-action-card shadow">
                    <div class="card-body text-center">
                        <i class="bi bi-scissors text-warning" style="font-size: 2rem;"></i>
                        <h5 class="mt-2">Split PDF</h5>
                    </div>
                </div>
            </a>
        </div>
        <!-- Extract Pages -->
        <div class="col-md-3 col-sm-6 mb-3">
            <a asp-controller="Pdf" asp-action="ExtractPages" class="text-decoration-none">
                <div class="card pdf-action-card shadow">
                    <div class="card-body text-center">
                        <i class="bi bi-file-earmark-text text-info" style="font-size: 2rem;"></i>
                        <h5 class="mt-2">Extract Pages</h5>
                    </div>
                </div>
            </a>
        </div>
        
        <!-- Compress PDF -->
        <div class="col-md-3 mb-3">
            <a asp-controller="Pdf" asp-action="Compress" class="text-decoration-none">
                <div class="card pdf-action-card shadow">
                    <div class="card-body text-center">
                        <i class="bi bi-file-earmark-zip text-success" style="font-size: 2rem;"></i>
                        <h5 class="mt-2">Compress PDF</h5>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>
