@{
    ViewData["Title"] = "Extract Pages from PDF";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white text-center">
                    <h4>Extract Pages from PDF</h4>
                </div>
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="pdfFile" class="form-label">Upload PDF File</label>
                            <input type="file" class="form-control" name="pdfFile" required />
                        </div>
                        <div class="mb-3 row">
                            <div class="col">
                                <label for="startPage" class="form-label">Start Page</label>
                                <input type="number" class="form-control" name="startPage" min="1" required />
                            </div>
                            <div class="col">
                                <label for="endPage" class="form-label">End Page</label>
                                <input type="number" class="form-control" name="endPage" min="1" required />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success w-100">Extract Pages</button>
                    </form>

                    @if (!string.IsNullOrEmpty(ViewBag.SuccessMessage))
                    {
                        <div id="successMessage" class="alert alert-success mt-3">
                            @ViewBag.SuccessMessage
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
                    {
                        <div class="alert alert-danger mt-3">
                            @ViewBag.ErrorMessage
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(ViewBag.DownloadLink))
                    {
                        <a id="downloadLink" href="@ViewBag.DownloadLink" class="btn btn-primary mt-3 w-100" download onclick="hideSuccessMessage()">Download Extracted PDF</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Pdf.js"></script>
}